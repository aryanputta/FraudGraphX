# ── Kafka ──────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=transactions.raw
KAFKA_TOPIC_ALERTS=fraud.alerts
KAFKA_TOPIC_ENRICHED=transactions.enriched
KAFKA_CONSUMER_GROUP=fraudgraphx-consumers
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# ── Spark ──────────────────────────────────────────────────────────────────────
SPARK_MASTER=local[*]
SPARK_APP_NAME=FraudGraphX
SPARK_CHECKPOINT_DIR=/tmp/spark-checkpoints
SPARK_BATCH_INTERVAL_SECS=5

# ── Cassandra ──────────────────────────────────────────────────────────────────
CASSANDRA_HOSTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fraudgraphx
CASSANDRA_USERNAME=cassandra
CASSANDRA_PASSWORD=cassandra
CASSANDRA_REPLICATION_FACTOR=3

# ── Neo4j ──────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fraudgraphx
NEO4J_DATABASE=fraudgraphx

# ── API ────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production
API_ALLOWED_ORIGINS=http://localhost:3000
ALERT_LATENCY_TARGET_MS=150

# ── ML Models ──────────────────────────────────────────────────────────────────
MODEL_DIR=/models
XGBOOST_MODEL_PATH=/models/xgboost_fraud.ubj
GNN_MODEL_PATH=/models/gnn_fraud.pt
LOGREG_MODEL_PATH=/models/logreg_fraud.pkl
FRAUD_THRESHOLD=0.5
GNN_FRAUD_THRESHOLD=0.6

# ── LLM (Anthropic) ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-key-here
LLM_MODEL=claude-sonnet-4-6
LLM_INVESTIGATOR_ENABLED=true

# ── Monitoring ─────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO

# ── Reinforcement Learning ─────────────────────────────────────────────────────
RL_THRESHOLD_LEARNING_RATE=0.01
RL_REWARD_FP_PENALTY=-1.0
RL_REWARD_FN_PENALTY=-10.0
RL_REWARD_TP_REWARD=5.0
RL_EPSILON=0.1

# ── AWS (Terraform) ────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
TF_STATE_BUCKET=fraudgraphx-tf-state
